           WHERE "user".id = user_department_join_table_1.user_id
             AND department_1.name = %(name_1)s::VARCHAR
             AND (EXISTS (SELECT 1 FROM department AS department_2 JOIN user_department_join_table AS user_department_join_table_2 ON department_2.id = user_department_join_table_2.department_id WHERE "user".id = user_department_join_table_2.user_id AND department_2.name = %(name_2)s::VARCHAR))
         )
   ORDER BY "user".id ASC
