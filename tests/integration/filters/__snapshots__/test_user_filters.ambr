             AND department_1.name = %s
             AND (EXISTS (SELECT 1 FROM department AS department_2 INNER JOIN user_department_join_table AS user_department_join_table_2 ON department_2.id = user_department_join_table_2.department_id WHERE user.id = user_department_join_table_2.user_id AND department_2.name = %s))
