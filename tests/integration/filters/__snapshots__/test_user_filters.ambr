# serializer version: 1
# name: test_and_same_to_many[session-async-tracked-aiosqlite_engine]
  '''
  SELECT user.name,
         user.id
    FROM USER AS USER
   WHERE EXISTS (
          SELECT 1
            FROM department AS department_1
            JOIN user_department_join_table AS user_department_join_table_1
              ON department_1.id = user_department_join_table_1.department_id
           WHERE user.id = user_department_join_table_1.user_id
             AND department_1.name = ?
             AND (EXISTS (SELECT 1 FROM department AS department_2 JOIN user_department_join_table AS user_department_join_table_2 ON department_2.id = user_department_join_table_2.department_id WHERE user.id = user_department_join_table_2.user_id AND department_2.name = ?))
         )
   ORDER BY user.id ASC
  '''
# ---
