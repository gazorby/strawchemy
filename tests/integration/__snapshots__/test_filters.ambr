# name: test_to_many_filter_and_column_filter[session-async-tracked-aiosqlite_engine]
  '''
  SELECT color.name,
         color.id,
         fruit_1.name AS name_1,
         fruit_1.id AS id_1
    FROM color AS color
    LEFT OUTER JOIN fruit AS fruit_1
      ON color.id = fruit_1.color_id
   WHERE color.name != ?
     AND (EXISTS (SELECT 1 FROM fruit AS fruit_2 WHERE color.id = fruit_2.color_id AND fruit_2.sweetness <= ?))
   ORDER BY color.id ASC,
            fruit_1.id ASC
  '''
# ---
# name: test_to_many_filter_and_column_filter[session-async-tracked-asyncmy_engine]
