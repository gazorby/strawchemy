# name: test_to_many_filter_paginates_distinct_parents[session-async-tracked-aiosqlite_engine]
  '''
  SELECT color.name,
         color.id
    FROM (
          SELECT color.name AS name,
                 color.id AS id
            FROM color AS color
           WHERE EXISTS (
                  SELECT 1
                    FROM fruit AS fruit_1
                   WHERE color.id = fruit_1.color_id
                     AND fruit_1.sweetness <= ?
                 )
           ORDER BY color.name ASC
           LIMIT ?
          OFFSET ?
         ) AS color
   ORDER BY color.name ASC
  '''
