   WHERE group_1.name = ?
     AND (EXISTS (SELECT 1 FROM department AS department_1 JOIN user_department_join_table AS user_department_join_table_1 ON department_1.id = user_department_join_table_1.department_id WHERE user.id = user_department_join_table_1.user_id AND department_1.name = ?))
