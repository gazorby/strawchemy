# name: test_delete_filter_on_relation[session-async-tracked-and-column-relation-aiosqlite_engine]
  '''
  DELETE
    FROM USER AS USER
   WHERE user.name = ?
     AND (EXISTS (SELECT 1 FROM USER AS user_1 JOIN user_department_join_table AS user_department_join_table_1 ON user_1.id = user_department_join_table_1.user_id JOIN department AS department_1 ON department_1.id = user_department_join_table_1.department_id WHERE department_1.name = ? AND user_1.id = user.id)) RETURNING id,
         id AS id_1
  '''
# ---
# name: test_delete_filter_on_relation[session-async-tracked-and-column-relation-asyncmy_engine]
  '''
  DELETE
    FROM USER AS USER
   WHERE user.name = %s
     AND (EXISTS (SELECT 1 FROM (SELECT user_1.id AS id FROM USER AS user_1 INNER JOIN user_department_join_table AS user_department_join_table_1 ON user_1.id = user_department_join_table_1.user_id INNER JOIN department AS department_1 ON department_1.id = user_department_join_table_1.department_id WHERE department_1.name = %s) AS anon_1 WHERE anon_1.id = user.id))
  '''
# ---
# name: test_delete_filter_on_relation[session-async-tracked-and-column-relation-asyncpg_engine]
  '''
  DELETE
    FROM "user" AS "user"
   WHERE "user".name = $1::VARCHAR
     AND (EXISTS (SELECT 1 FROM "user" AS user_1 JOIN user_department_join_table AS user_department_join_table_1 ON user_1.id = user_department_join_table_1.user_id JOIN department AS department_1 ON department_1.id = user_department_join_table_1.department_id WHERE department_1.name = $2::VARCHAR AND user_1.id = "user".id)) RETURNING "user".id,
         "user".id AS id_1
