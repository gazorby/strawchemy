# name: test_delete_filter_on_relation[session-async-tracked-and-column-relation-psycopg_async_engine]
  '''
  DELETE
    FROM "user" AS "user"
   WHERE "user".name = %(name_1)s::VARCHAR
     AND (EXISTS (SELECT 1 FROM "user" AS user_1 JOIN user_department_join_table AS user_department_join_table_1 ON user_1.id = user_department_join_table_1.user_id JOIN department AS department_1 ON department_1.id = user_department_join_table_1.department_id WHERE department_1.name = %(name_2)s::VARCHAR AND user_1.id = "user".id)) RETURNING "user".id,
         "user".id AS id_1
  '''
# ---
# name: test_delete_filter_on_relation[session-async-tracked-column-aiosqlite_engine]
  '''
  DELETE
    FROM USER AS USER
   WHERE user.name = ? RETURNING id,
         id AS id_1
  '''
# ---
# name: test_delete_filter_on_relation[session-async-tracked-column-and-aggregation-aiosqlite_engine]
  '''
  WITH anon_1 AS (
          SELECT count(department_1.id) AS count_1,
                 user_2.id AS id
            FROM USER AS user_2
            JOIN user_department_join_table AS user_department_join_table_1
              ON user_2.id = user_department_join_table_1.user_id
            JOIN department AS department_1
              ON department_1.id = user_department_join_table_1.department_id
           GROUP BY user_2.id
         ) DELETE
    FROM USER AS USER
   WHERE user.name != ?
     AND (EXISTS (SELECT 1 FROM USER AS user_1 LEFT OUTER JOIN anon_1 ON user_1.id = anon_1.id WHERE coalesce(anon_1.count_1, ?) > ? AND user_1.id = user.id)) RETURNING id,
         id AS id_1
  '''
# ---
# name: test_delete_filter_on_relation[session-async-tracked-column-and-aggregation-asyncmy_engine]
  '''
  WITH anon_2 AS (
          SELECT count(department_1.id) AS count_1,
                 user_2.id AS id
            FROM USER AS user_2
           INNER JOIN user_department_join_table AS user_department_join_table_1
              ON user_2.id = user_department_join_table_1.user_id
           INNER JOIN department AS department_1
              ON department_1.id = user_department_join_table_1.department_id
           GROUP BY user_2.id
         ) DELETE
    FROM USER AS USER
   WHERE user.name != %s
     AND (EXISTS (SELECT 1 FROM (SELECT user_1.id AS id FROM USER AS user_1 LEFT OUTER JOIN anon_2 ON user_1.id = anon_2.id WHERE coalesce(anon_2.count_1, %s) > %s) AS anon_1 WHERE anon_1.id = user.id))
  '''
# ---
# name: test_delete_filter_on_relation[session-async-tracked-column-and-aggregation-asyncpg_engine]
  '''
  DELETE
    FROM "user" AS "user"
   WHERE "user".name != $1::VARCHAR
     AND (EXISTS (SELECT 1 FROM "user" AS user_1 JOIN LATERAL (SELECT count(department_1.id) AS count_1 FROM user_department_join_table AS user_department_join_table_1 JOIN department AS department_1 ON department_1.id = user_department_join_table_1.department_id WHERE user_1.id = user_department_join_table_1.user_id) AS anon_1 ON TRUE WHERE anon_1.count_1 > $2::INTEGER AND user_1.id = "user".id)) RETURNING "user".id,
         "user".id AS id_1
