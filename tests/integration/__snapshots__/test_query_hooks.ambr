# ---
# name: test_query_hook_joining_on_relation[session-async-tracked-aiosqlite_engine]
  '''
  WITH anon_1 AS (
          SELECT fruit_1.name AS name,
                 fruit_1.id AS id,
                 fruit_1.color_id AS color_id,
                 dense_rank() OVER (PARTITION BY fruit_1.color_id ORDER BY fruit_1.id ASC) AS rank
            FROM fruit AS fruit_1
            JOIN fruit_farm
              ON fruit_farm.fruit_id = fruit_1.id
           WHERE fruit_1.color_id IS NOT NULL
             AND (fruit_farm.name LIKE '%' || ?)
           GROUP BY fruit_1.color_id,
                    fruit_1.name,
                    fruit_1.id
           ORDER BY fruit_1.id ASC
         ) SELECT anon_1.name,
         anon_1.id,
         color.name AS name_1,
         color.id AS id_1
    FROM color AS color
    LEFT OUTER JOIN anon_1
      ON color.id = anon_1.color_id
   ORDER BY color.id ASC,
            anon_1.id ASC
  '''
