# name: test_declared_aggregate_count_filter[session-async-tracked-aiosqlite_engine]
  '''
  WITH anon_1 AS (
          SELECT count(fruit_1.id) AS count_1,
                 fruit_1.color_id AS color_id
            FROM fruit AS fruit_1
           WHERE fruit_1.color_id IS NOT NULL
           GROUP BY fruit_1.color_id
         ) SELECT color.id
    FROM color AS color
    LEFT OUTER JOIN anon_1
      ON color.id = anon_1.color_id
   WHERE coalesce(anon_1.count_1, ?) > ?
   ORDER BY color.id ASC
  '''
# ---
# name: test_declared_aggregate_count_filter[session-async-tracked-asyncmy_engine]
  '''
  WITH anon_1 AS (
