# ---
# name: test_paginated_relation_order_by_nested_aggregation[session-async-tracked-aiosqlite_engine]
  '''
  WITH anon_2 AS (
          SELECT count(*) AS count_1,
                 fruit_farm_1.fruit_id AS fruit_id
            FROM fruit_farm AS fruit_farm_1
           WHERE fruit_farm_1.fruit_id IS NOT NULL
           GROUP BY fruit_farm_1.fruit_id
         ),
         anon_1 AS (
          SELECT fruit_1.name AS name,
                 fruit_1.sweetness AS sweetness,
                 fruit_1.id AS id,
                 coalesce(anon_2.count_1, ?) AS coalesce_1,
                 fruit_1.color_id AS color_id,
                 dense_rank() OVER (PARTITION BY fruit_1.color_id ORDER BY coalesce(anon_2.count_1, ?) DESC, fruit_1.sweetness ASC) AS rank
            FROM fruit AS fruit_1
            LEFT OUTER JOIN anon_2
              ON fruit_1.id = anon_2.fruit_id
           WHERE fruit_1.color_id IS NOT NULL
           GROUP BY fruit_1.color_id,
                    fruit_1.name,
                    fruit_1.sweetness,
                    fruit_1.id,
                    coalesce(anon_2.count_1, ?)
           ORDER BY coalesce(anon_2.count_1, ?) DESC, fruit_1.sweetness ASC
         ) SELECT anon_1.name,
         anon_1.sweetness,
         anon_1.id,
         color.id AS id_1
    FROM (
          SELECT color.id AS id
            FROM color AS color
           ORDER BY color.id ASC
           LIMIT ?
          OFFSET ?
         ) AS color
    LEFT OUTER JOIN anon_1
      ON color.id = anon_1.color_id
     AND anon_1.rank <= ?
   ORDER BY color.id ASC,
            anon_1.coalesce_1 DESC,
            anon_1.sweetness ASC
  '''
# ---
# name: test_paginated_relation_order_by_nested_aggregation[session-async-tracked-asyncmy_engine]
  '''
  WITH anon_2 AS (
