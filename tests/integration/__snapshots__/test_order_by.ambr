         anon_1.id,
         color.id AS id_1
    FROM (
          SELECT color.id AS id
            FROM color AS color
           ORDER BY color.id ASC
           LIMIT %s,
                 %s
         ) AS color
    LEFT OUTER JOIN anon_1
      ON color.id = anon_1.color_id
     AND anon_1.`rank` <= %s
   ORDER BY color.id ASC,
            anon_1.coalesce_1 DESC,
            anon_1.sweetness ASC
  '''
# ---
# name: test_paginated_relation_order_by_nested_aggregation[session-async-tracked-asyncpg_engine]
  '''
