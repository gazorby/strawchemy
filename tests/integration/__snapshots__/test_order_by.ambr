# name: test_order_by_aggregations[session-async-tracked-ASC-avg-aiosqlite_engine]
  '''
  WITH anon_1 AS (
          SELECT avg(fruit_2.water_percent) AS avg_1,
                 fruit_2.color_id AS color_id
            FROM fruit AS fruit_2
           WHERE fruit_2.color_id IS NOT NULL
           GROUP BY fruit_2.color_id
         ) SELECT fruit_1.water_percent,
         fruit_1.id,
         color.id AS id_1
    FROM color AS color
    LEFT OUTER JOIN anon_1
      ON color.id = anon_1.color_id
    LEFT OUTER JOIN fruit AS fruit_1
      ON color.id = fruit_1.color_id
   ORDER BY anon_1.avg_1 ASC,
            fruit_1.id ASC
  '''
# ---
# name: test_order_by_aggregations[session-async-tracked-ASC-avg-asyncmy_engine]
  '''
  WITH anon_1 AS (
          SELECT avg(fruit_2.water_percent) AS avg_1,
                 fruit_2.color_id AS color_id
            FROM fruit AS fruit_2
           WHERE fruit_2.color_id IS NOT NULL
           GROUP BY fruit_2.color_id
         ) SELECT fruit_1.water_percent,
         fruit_1.id,
         color.id AS id_1
    FROM color AS color
    LEFT OUTER JOIN anon_1
      ON color.id = anon_1.color_id
    LEFT OUTER JOIN fruit AS fruit_1
      ON color.id = fruit_1.color_id
   ORDER BY anon_1.avg_1 ASC,
            fruit_1.id ASC
  '''
# ---
# name: test_order_by_aggregations[session-async-tracked-ASC-avg-asyncpg_engine]
  '''
  SELECT fruit_1.water_percent,
         fruit_1.id,
         color.id AS id_1
    FROM color AS color
    JOIN LATERAL (
          SELECT avg(fruit_2.water_percent) AS avg_1
            FROM fruit AS fruit_2
           WHERE color.id = fruit_2.color_id
         ) AS anon_1
      ON TRUE
    LEFT OUTER JOIN fruit AS fruit_1
      ON color.id = fruit_1.color_id
   ORDER BY anon_1.avg_1 ASC,
            fruit_1.id ASC
  '''
