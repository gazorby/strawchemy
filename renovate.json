{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:weekly",
    ":maintainLockFilesWeekly",
    ":preserveSemverRanges"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "dependencyDashboardApproval": true,
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "dependencyDashboardCategory": "🔄 Maintenance"
  },
  "packageRules": [
    {
      "matchCategories": [
        "cd",
        "ci"
      ],
      "dependencyDashboardCategory": "⬆️ Continuous Integration & Continuous Deployment"
    },
    {
      "matchDepTypes": [
        "tool.uv.dev-dependencies",
        "tool.uv.sources"
      ],
      "dependencyDashboardCategory": "🛠️ Development Dependencies"
    },
    {
      "matchUpdateTypes": "major",
      "dependencyDashboardCategory": "💔 Major Updates"
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "dependencyDashboardCategory": "</> Language version"
    }
  ],
  "separateMinorPatch": true
}
